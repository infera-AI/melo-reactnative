{
  "name": "melo-app-reactnative",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "start-fresh": "react-native start --reset-cache",
    "test": "jest",
    "install-legacy": "npm install --legacy-peer-deps",
    "clean-install": "npm cache clean --force && npm install --legacy-peer-deps",
    "reset": "npm cache clean --force && npx react-native start --reset-cache",
    "debug": "npx react-native log-android",
    "log-ios": "npx react-native log-ios",
    "flipper": "npx react-native log-android | grep -E '(DEBUG|ERROR|WARN)'",
    "clear-cache": "npx react-native start --reset-cache",
    "link": "adb reverse tcp:8081 tcp:8081",
    "build-android-debug": "cd android && ./gradlew assembleDebug",
    "build-android-release": "cd android && ./gradlew assembleRelease",
    "build-android-clean": "cd android && ./gradlew clean",
    "build-release": "npm run build-android-clean && npm run build-android-release"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-documents/picker": "^10.1.5",
    "@react-native/new-app-screen": "0.80.1",
    "axios": "^1.10.0",
    "i18next": "^25.3.1",
    "js-base64": "^3.7.7",
    "mobx": "^6.13.7",
    "mobx-react-lite": "^4.1.0",
    "react": "19.1.0",
    "react-i18next": "^15.6.0",
    "react-native": "0.80.1",
    "react-native-audio-record": "^0.2.2",
    "react-native-audio-recorder-player": "^3.6.10",
    "react-native-fs": "^2.20.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-super-grid": "^6.0.1",
    "react-native-vector-icons": "^10.2.0",
    "react-native-webview": "^13.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "19.0.0",
    "@react-native-community/cli-platform-android": "19.0.0",
    "@react-native-community/cli-platform-ios": "19.0.0",
    "@react-native/babel-preset": "0.80.1",
    "@react-native/eslint-config": "0.80.1",
    "@react-native/metro-config": "0.80.1",
    "@react-native/typescript-config": "0.80.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-console-time-polyfill": "^1.2.3",
    "react-native-logs": "^5.3.0",
    "react-test-renderer": "19.1.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
